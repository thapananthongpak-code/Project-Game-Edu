# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่า ห้าม commit .env (ถูก ignore แล้ว)
# บน Vercel ให้ตั้งค่าเดียวกันที่ Project Settings → Environment Variables แล้ว Redeploy (ดู README.md)

# ---------- ค่าสาธารณะ: ฝังลงในโค้ดฝั่งเบราว์เซอร์ตอน build (ชื่อขึ้นต้นด้วย VITE_) ----------
# ไม่ตั้งสองค่านี้ = เกมเก็บความคืบหน้าในเครื่องของผู้เรียนอย่างเดียว ครูไม่เห็นข้อมูล
# URL ของโปรเจกต์ Supabase เช่น https://xxxxxxxx.supabase.co
VITE_SUPABASE_URL=
# คีย์สาธารณะของ Supabase (anon public key หรือ Publishable key) เปิดเผยได้ สิทธิ์จริงคุมด้วย RLS ใน supabase/schema.sql
VITE_SUPABASE_ANON_KEY=

# ---------- ค่าลับ: ใช้ฝั่งเซิร์ฟเวอร์เท่านั้น (api/*.ts) ห้ามตั้งชื่อขึ้นต้นด้วย VITE_ ----------
# แดชบอร์ดผู้สอน (/teacher): URL เดียวกับข้างบน คีย์ service_role (หรือ Secret key) และรหัสผ่านครูอย่างน้อย 8 ตัวอักษร (แนะนำ 12 ขึ้นไป)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TEACHER_PASSWORD=
# ติวเตอร์ AI "ถามพี่บิต" (api/tutor.ts) ไม่ตั้ง = พี่บิตตอบด้วยคำใบ้สำเร็จรูปจากเนื้อหาของห้อง
ANTHROPIC_API_KEY=

# ---------- เครื่องมือของผู้พัฒนา (ไม่ต้องตั้งบน Vercel) ----------
# token ของ Pixel Lab สำหรับ npm run pixellab
PIXELLAB_API_TOKEN=
